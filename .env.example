# Copy to .env and fill in. Never commit .env.

# --- Data sources (public) ---
# Materials Project: free key from https://next-gen.materialsproject.org/api
MP_API_KEY=

# OpenAlex asks for a contact email to use the faster "polite pool". Optional.
OPENALEX_MAILTO=

# --- LLM edges (optional; the system runs fully without any of these) ---
# Provider: none | anthropic | openai_compatible
LLM_PROVIDER=none

# Anthropic (cloud). Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5

# Locally hosted, OpenAI-compatible server (vLLM, Ollama, llama.cpp).
# Only used when LLM_PROVIDER=openai_compatible. Nothing leaves the site.
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_API_KEY=not-needed

# --- Runtime ---
# Path to the SQLite cache (inside the container this is a mounted volume)
OXIDE_TRIAGE_CACHE=data/cache.sqlite
# Force offline mode regardless of config (1/0)
OXIDE_TRIAGE_OFFLINE=0
