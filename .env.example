# Copy to .env and fill in. Never commit .env.

# --- Data sources (public) ---
# Materials Project: free key from https://next-gen.materialsproject.org/api
MP_API_KEY=

# Optional. OpenAlex meters API use against a daily budget: $0.10/day per IP without a key,
# $1.00/day with a free account's key (https://openalex.org -> account -> API key). Literature
# counts are fetched per query for the top-ranked candidates (about 50 searches, $0.05), so the
# key matters only if you run more than a couple of queries a day on uncached candidates.
OPENALEX_API_KEY=
# Contact email sent with OpenAlex requests. Optional; no longer changes rate limits.
OPENALEX_MAILTO=

# --- LLM edges (optional; the system runs fully without any of these) ---
# Provider: none | anthropic | openai_compatible. The Streamlit Agent page and `oxide-triage
# chat` need anthropic or openai_compatible; everything else works with none.
LLM_PROVIDER=none

# Anthropic (cloud). Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5

# Locally hosted, OpenAI-compatible server (vLLM, Ollama, llama.cpp).
# Only used when LLM_PROVIDER=openai_compatible. Nothing leaves the site.
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_API_KEY=not-needed

# --- Runtime ---
# Path to the SQLite cache (inside the container this is a mounted volume)
OXIDE_TRIAGE_CACHE=data/cache.sqlite
# Force offline mode regardless of config (1/0)
OXIDE_TRIAGE_OFFLINE=0
