{#- Self-contained HTML report. No external assets, no scripts required; works offline and prints.
    Every value is pre-computed in `result`; this file only lays it out. Autoescaping is on:
    retrieved text (paper titles, source fields) is displayed, never interpreted. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Oxbow: materials triage — {{ result.profile_name }}</title>
<style>
  :root {
    --bg: #fbfaf7; --fg: #1d1d1b; --muted: #5f5e58; --line: #e3e0d8; --card: #ffffff;
    --accent: #2f6f5e; --accent-soft: #dcefe8; --warn: #a15c00; --warn-soft: #fff1dc;
    --crit: #9b2226; --crit-soft: #fde4e4; --info: #35507a; --info-soft: #e3eaf6;
    --known: #2f6f5e; --unknown: #c9c4b8; --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #15171a; --fg: #ecebe6; --muted: #a6a49c; --line: #2c3036; --card: #1d2024;
      --accent: #7cc4ad; --accent-soft: #1f3a33; --warn: #f0b35c; --warn-soft: #3a2a12;
      --crit: #f08a8d; --crit-soft: #401c1e; --info: #9db8e6; --info-soft: #1c2637;
      --known: #7cc4ad; --unknown: #3a3e45; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 24px 16px 48px; background: var(--bg); color: var(--fg);
    font: 15px/1.5 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
  main { max-width: 1040px; margin: 0 auto; }
  h1 { font-size: 26px; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 19px; margin: 36px 0 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  h3 { font-size: 16px; margin: 18px 0 8px; }
  p { margin: 8px 0; }
  .sub { color: var(--muted); }
  h1 .sub { font-size: 0.55em; font-weight: 400; margin-left: 10px; }
  .banner { border-radius: 8px; padding: 12px 14px; margin: 12px 0; border: 1px solid; }
  .banner.crit { background: var(--crit-soft); border-color: var(--crit); }
  .banner.warn { background: var(--warn-soft); border-color: var(--warn); }
  .banner.info { background: var(--info-soft); border-color: var(--info); }
  .banner.ok { background: var(--accent-soft); border-color: var(--accent); }
  .banner strong { display: block; margin-bottom: 2px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px 16px;
    font-size: 13.5px; color: var(--muted); margin: 12px 0 0; }
  .meta b { color: var(--fg); font-weight: 600; }
  code, .mono { font-family: var(--mono); font-size: 12.5px; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin: 8px 0; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.03em; }
  .wrap { overflow-x: auto; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin: 12px 0; }
  .card-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .rank { font-size: 22px; font-weight: 700; color: var(--accent); min-width: 34px; }
  .formula { font-size: 20px; font-weight: 700; }
  .pill { display: inline-block; border-radius: 999px; padding: 1px 9px; font-size: 12px; font-weight: 600; }
  .pill.high { background: var(--accent-soft); color: var(--accent); }
  .pill.medium { background: var(--warn-soft); color: var(--warn); }
  .pill.low { background: var(--crit-soft); color: var(--crit); }
  .pill.gray { background: var(--line); color: var(--muted); }
  .pill.warn { background: var(--warn-soft); color: var(--warn); }
  .bar { position: relative; height: 10px; background: var(--line); border-radius: 5px; overflow: hidden; min-width: 120px; }
  .bar > span { position: absolute; inset: 0 auto 0 0; background: var(--accent); border-radius: 5px; }
  .bar.unknown > span { background: repeating-linear-gradient(45deg, var(--unknown), var(--unknown) 4px, transparent 4px, transparent 8px); width: 100% !important; }
  .why { margin: 8px 0 4px; }
  .caveat { margin: 4px 0; padding-left: 10px; border-left: 3px solid var(--line); }
  .caveat.critical { border-color: var(--crit); }
  .caveat.warning { border-color: var(--warn); }
  .caveat.info { border-color: var(--info); }
  .tag { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
  details { margin-top: 8px; }
  summary { cursor: pointer; color: var(--accent); font-weight: 600; }
  .gapmap td.k { background: var(--known); color: #fff; text-align: center; }
  .gapmap td.u { background: var(--unknown); color: var(--fg); text-align: center; }
  .gapmap td.n { text-align: center; color: var(--muted); }
  .scope { font-style: italic; }
  footer { margin-top: 40px; color: var(--muted); font-size: 12.5px; border-top: 1px solid var(--line); padding-top: 12px; }
  @media print { body { padding: 0; } details { display: block; } details > *:not(summary) { display: block; } .card { break-inside: avoid; } }
</style>
</head>
<body>
<main>
{% set passing = result.shortlist + result.ranked_beyond_shortlist %}
<header>
  <h1>Oxbow <span class="sub">materials triage · {{ result.profile_name }}</span></h1>
  <p class="sub">{{ result.request_text }}</p>
  <div class="meta">
    <div>Profile <b>{{ result.profile_name }}</b></div>
    <div>Considered <b>{{ result.n_candidates_considered }}</b> · passed gates <b>{{ passing | length }}</b> · excluded <b>{{ result.excluded | length }}</b></div>
    <div>Self-check <b>{{ result.selfcheck_status or "—" }}</b></div>
    <div>Generated <b>{{ result.generated_at }}</b></div>
  </div>
</header>

{% if result.fixture_data %}
<div class="banner crit"><strong>Synthetic fixture data</strong>This run used the built-in development fixture, not live public databases. Every number below is illustrative. Do not act on it.</div>
{% endif %}
{% if not result.guard.proceed %}
<div class="banner crit"><strong>Request declined</strong><pre style="white-space:pre-wrap;margin:6px 0 0">{{ result.warnings[0] }}</pre></div>
{% endif %}
{% if result.needs_confirmation %}
<div class="banner warn"><strong>Not run: confirmation needed</strong><ul>{% for q in result.clarifications %}<li>{{ q }}</li>{% endfor %}</ul></div>
{% endif %}
{% for d in result.deviations %}
<div class="banner warn"><strong>Configuration deviation ({{ d.origin }})</strong>{{ d.description }}</div>
{% endfor %}
{% for f in result.guard.findings if f.bin.value in ["architecturally_impossible", "override_attempt"] %}
<div class="banner info"><strong>{{ "Not possible in this deployment" if f.bin.value == "architecturally_impossible" else "No such mode exists" }}</strong>“{{ f.matched_text }}” — {{ f.explanation }}</div>
{% endfor %}
{% for w in result.warnings if result.guard.proceed and not result.needs_confirmation %}
<div class="banner info">{{ w }}</div>
{% endfor %}
{% if result.retrieval and not result.retrieval.comparable %}
<div class="banner warn"><strong>Incomplete retrieval — the order below is not a ranking</strong>
Only {{ result.retrieval.completeness | pct }} of the data this ranking needed was downloaded into
the cache; {{ result.retrieval.n_fully_retrieved }} of {{ result.retrieval.n_ranked }} candidates
have a complete record. Missing data lowers a candidate's score, so position here partly reflects
which downloads finished rather than which materials are better. Warm the cache and re-run before
comparing candidates against each other.</div>
{% endif %}
{% if result.criteria.interpretation_notes %}
<p class="sub">How the request was read: {{ result.criteria.interpretation_notes | join("; ") }}</p>
{% endif %}
{% if result.not_acted_on %}
<div class="banner warn"><strong>Parts of the request not acted on</strong><ul style="margin:6px 0 0 18px;padding:0">{% for line in result.not_acted_on %}<li>{{ line }}</li>{% endfor %}</ul></div>
{% endif %}

{% set shared = result.run_notes | map(attribute="code") | list %}
{% if result.run_notes %}
<div class="banner info"><strong>Applies to every shortlisted candidate</strong><ul style="margin:6px 0 0 18px;padding:0">{% for c in result.run_notes %}<li>({{ c.severity }}) {{ c.text }}</li>{% endfor %}</ul></div>
{% endif %}
{% if result.shortlist %}
<h2>Shortlist</h2>
{% for sc in result.shortlist %}
{% set r = sc.record %}
{% set cav = sc | primary_caveat(shared) %}
<section class="card">
  <div class="card-head">
    <span class="rank">{{ sc.rank }}</span>
    <span class="formula">{{ r.formula }}</span>
    <span class="tag">{{ r.material_id }} · {{ r.crystal_system or "?" }} {{ r.spacegroup_symbol or "" }}</span>
    {% if sc.tier is not none %}<span class="pill gray" title="Candidates within {{ result.tie_band }} of a tier's leader share the tier; the order inside a tier is arbitrary.">tier {{ sc.tier }}</span>{% endif %}
    <span class="pill {{ sc.confidence }}">confidence {{ sc.confidence }}</span>
    {% if sc.absent_criteria %}<span class="pill gray">no data: {{ sc.absent_criteria | join(", ") }}</span>{% endif %}
    {% if sc.not_retrieved_criteria %}<span class="pill warn" title="Never downloaded into this cache; the score is lowered by data the system failed to collect, so this rank is not comparable.">never downloaded: {{ sc.not_retrieved_criteria | join(", ") }}</span>{% endif %}
  </div>
  <div style="display:flex;align-items:center;gap:12px;margin-top:8px">
    <div class="bar" style="flex:1"><span style="width:{{ (100 * (sc.adjusted_score or 0)) | round(1) }}%"></span></div>
    <span class="mono">score {{ sc.adjusted_score | fmt(3) }} · coverage {{ sc.data_coverage | pct }}</span>
  </div>
  <p class="why"><b>Why:</b> {{ sc.rationale }}</p>
  {% if cav %}<div class="caveat {{ cav.severity }}"><b>Main caveat:</b> {{ cav.text }}</div>{% endif %}
  <details>
    <summary>Full breakdown ({{ sc.caveats | length }} caveats, {{ sc.components | length }} components, {{ sc.gates | length }} gates)</summary>
    <h3>Score components</h3>
    <div class="wrap"><table>
      <tr><th>Criterion</th><th>Weight</th><th>Observed</th><th>Normalised</th><th style="min-width:140px">Contribution</th></tr>
      {% for c in sc.components %}
      <tr>
        <td>{{ c.criterion }}</td><td class="mono">{{ c.weight | fmt(3) }}</td><td>{{ c.raw_label }}</td>
        <td class="mono">{{ c.normalized | fmt(3) }}</td>
        <td>{% if c.contribution is not none %}<div class="bar"><span style="width:{{ (100 * c.contribution / (c.weight if c.weight else 1)) | round(1) }}%"></span></div><span class="mono">{{ c.contribution | fmt(4) }}</span>{% else %}<div class="bar unknown"><span></span></div><span class="tag">unknown — no credit</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table></div>
    <h3>Gates</h3>
    <div class="wrap"><table>
      <tr><th>Gate</th><th>Threshold</th><th>Observed</th><th>Result</th></tr>
      {% for g in sc.gates %}<tr><td>{{ g.gate }}</td><td>{{ g.threshold_label }}</td><td>{{ g.observed_label }}</td><td>{{ "pass" if g.passed else ("indeterminate" if g.passed is none else "FAIL") }}</td></tr>{% endfor %}
    </table></div>
    <p><b>Band gap:</b> {{ sc.band_gap_assessment.correction_note }}</p>
    <p><b>Stability cross-check:</b> {{ sc.cross_source_agreement }}{% if r.cross_check.stability_ev_atom is not none %} (OQMD hull distance {{ r.cross_check.stability_ev_atom | fmt(3) }} eV/atom){% endif %}{% if r.cross_check.provenance and r.cross_check.provenance.note %} · {{ r.cross_check.provenance.note }}{% endif %}</p>
    <h3>Provenance</h3>
    <div class="wrap"><table>
      <tr><th>Field</th><th>Source</th><th>Id</th><th>Retrieved</th><th>Functional / note</th></tr>
      <tr><td>stability</td><td>{{ r.stability.provenance.source if r.stability.provenance else "—" }}</td><td class="mono">{{ r.stability.provenance.source_id if r.stability.provenance else "—" }}</td><td class="mono">{{ r.stability.provenance.retrieved_at if r.stability.provenance else "—" }}</td><td>{{ r.stability.functional }}</td></tr>
      <tr><td>band gap</td><td>{{ r.band_gap.provenance.source if r.band_gap.provenance else "—" }}</td><td class="mono">{{ r.band_gap.provenance.source_id if r.band_gap.provenance else "—" }}</td><td class="mono">{{ r.band_gap.provenance.retrieved_at if r.band_gap.provenance else "—" }}</td><td>{{ r.band_gap.functional }}</td></tr>
      <tr><td>{{ r.figure_of_merit.criterion }}</td><td>{{ r.figure_of_merit.provenance.source if r.figure_of_merit.provenance else "—" }}</td><td class="mono">{{ r.figure_of_merit.provenance.source_id if r.figure_of_merit.provenance else "—" }}</td><td class="mono">{{ r.figure_of_merit.provenance.retrieved_at if r.figure_of_merit.provenance else "—" }}</td><td>{{ r.figure_of_merit.status.value }}{% if r.figure_of_merit.provenance and r.figure_of_merit.provenance.note %} · {{ r.figure_of_merit.provenance.note }}{% endif %}</td></tr>
      <tr><td>literature</td><td>{{ r.literature.provenance.source if r.literature.provenance else "—" }}</td><td>{{ r.literature.query_terms | join(", ") }}</td><td class="mono">{{ r.literature.provenance.retrieved_at if r.literature.provenance else "—" }}</td><td>{{ r.literature.status.value }}{% if r.literature.provenance and r.literature.provenance.note %} · {{ r.literature.provenance.note }}{% endif %}</td></tr>
      <tr><td>hazard</td><td>{{ r.hazard.provenance.source if r.hazard.provenance else "—" }}</td><td class="mono">{{ r.hazard.provenance.source_id if r.hazard.provenance else "—" }}</td><td>{{ r.hazard.provenance.note if r.hazard.provenance else "—" }}</td><td>PubChem {{ r.hazard.pubchem_status.value }}{% if r.hazard.pubchem_cid %} (CID {{ r.hazard.pubchem_cid }}){% endif %}</td></tr>
    </table></div>
    {% if r.literature.sample_works %}
    <h3>Literature sample <span class="tag">retrieved titles; data, not endorsements</span></h3>
    <ul>{% for w in r.literature.sample_works %}<li>{{ w.year or "?" }} — {{ w.title }} <span class="tag">{{ w.work_id }}</span></li>{% endfor %}</ul>
    {% endif %}
    <h3>All caveats</h3>
    {% for c in sc.caveats %}<div class="caveat {{ c.severity }}"><span class="tag">[{{ c.severity }}] {{ c.code }} ({{ c.origin }})</span><br>{{ c.text }}</div>{% endfor %}
  </details>
</section>
{% endfor %}
{% elif result.guard.proceed and not result.needs_confirmation %}
<h2>Shortlist</h2>
<p class="sub">No candidate passed every gate under this configuration.</p>
{% endif %}

{% if passing %}
<h2>Data-gap map <span class="tag">which criteria had data behind them, per passing candidate</span></h2>
<div class="wrap"><table class="gapmap">
  <tr><th>#</th><th>Formula</th>{% for c in result.shortlist[0].components if result.shortlist %}<th>{{ c.criterion }}</th>{% endfor %}<th>Coverage</th><th>Confidence</th></tr>
  {% for sc in passing %}
  <tr><td class="mono">{{ sc.rank }}</td><td>{{ sc.record.formula }}</td>
    {% for c in sc.components %}<td class="{{ 'k' if c.status.value == 'known' else 'u' }}" title="{{ c.raw_label }}">{{ "●" if c.status.value == "known" else "?" }}</td>{% endfor %}
    <td class="mono">{{ sc.data_coverage | pct }}</td><td><span class="pill {{ sc.confidence }}">{{ sc.confidence }}</span></td></tr>
  {% endfor %}
</table></div>
<p class="sub">● data present · ? no data (earns no credit, lowers confidence, listed by name). Hover a cell for the observed value.</p>
{% endif %}

{% if result.ranked_beyond_shortlist %}
<h2>Passed the gates, beyond the shortlist ({{ result.ranked_beyond_shortlist | length }} compounds{% if result.collapsed_polymorphs %}; {{ result.collapsed_polymorphs | length }} further phases collapsed under their compound's row{% endif %})</h2>
<div class="wrap"><table>
  <tr><th>#</th><th>Formula</th><th>Score</th><th>Coverage</th><th>Confidence</th><th>Missing</th><th>Main caveat</th></tr>
  {% for sc in result.ranked_beyond_shortlist %}{% set cav = sc | primary_caveat(shared) %}
  <tr><td class="mono">{{ sc.rank }}</td><td>{{ sc.record.formula }} <span class="tag">{{ sc.record.material_id }}</span>{% if sc.polymorphs %} <span class="tag">+{{ sc.polymorphs | length }} phase{{ "s" if sc.polymorphs | length > 1 }}</span>{% endif %}</td><td class="mono">{{ sc.adjusted_score | fmt(3) }}</td><td class="mono">{{ sc.data_coverage | pct }}</td><td>{{ sc.confidence }}</td><td>{{ sc.absent_criteria | join(", ") or "—" }}{% if sc.not_retrieved_criteria %} <b>(not downloaded: {{ sc.not_retrieved_criteria | join(", ") }})</b>{% endif %}</td><td>{{ cav.code if cav else "—" }}</td></tr>
  {% endfor %}
</table></div>
{% endif %}

{% if result.excluded %}
<h2>Excluded by a gate ({{ result.excluded | length }})</h2>
<div class="wrap"><table>
  <tr><th>Formula</th><th>Id</th><th>Reason(s)</th></tr>
  {% for sc in result.excluded %}<tr><td>{{ sc.record.formula }}</td><td class="mono">{{ sc.record.material_id }}</td><td>{{ sc.exclusion_reasons | join("; ") }}</td></tr>{% endfor %}
</table></div>
{% endif %}

<h2>How the ranking was computed</h2>
<p class="mono">{{ result.scoring.formula }}</p>
<p>Missing-data policy <b>{{ result.scoring.missing_data_policy }}</b>, penalty {{ result.scoring.missing_data_penalty }}; confidence thresholds {{ result.scoring.confidence_thresholds }}.</p>
<div class="wrap"><table>
  <tr><th>Criterion</th><th>Weight</th></tr>
  {% for k, v in result.scoring.weights | dictsort %}<tr><td>{{ k }}</td><td class="mono">{{ v | fmt(3) }}</td></tr>{% endfor %}
</table></div>
<div class="wrap"><table>
  <tr><th>Gate</th><th>Setting</th></tr>
  {% for k, v in result.scoring.gates | dictsort %}<tr><td>{{ k }}</td><td class="mono">{{ v }}</td></tr>{% endfor %}
</table></div>
{% if result.acquisition_summary %}
<h3>Last acquisition pass on this cache</h3>
<p>{{ result.acquisition_summary.finished_at }} · planner <code>{{ result.acquisition_summary.planner }}</code> · {{ result.acquisition_summary.gaps }} gaps, {{ result.acquisition_summary.filled }} filled by alternative routes, {{ result.acquisition_summary.unfillable }} with no public route{% if result.acquisition_summary.budget_exhausted %} · <b>budget exhausted</b>{% endif %}.</p>
{% endif %}

{% if eval_summary %}
<h2>Evaluation checks{% if eval_data_label %} <span class="tag">{{ eval_data_label }}</span>{% endif %}</h2>
<div class="wrap"><table>
  <tr><th>Check</th><th>Result</th></tr>
  {% for name, ok in eval_summary.items() %}<tr><td>{{ name }}</td><td><span class="pill {{ 'high' if ok else 'low' }}">{{ "PASS" if ok else "FAIL" }}</span></td></tr>{% endfor %}
</table></div>
{% endif %}

<h2>Read this before running anything</h2>
<p class="scope">{{ result.scope_limitation }}</p>
<p class="sub">Scores are relative within this run and profile. A candidate with a <em>medium</em> or <em>low</em> confidence label has criteria with no data behind them; they are named, not scored as zero. Band gaps marked “corrected” are scaled DFT values, not measurements. A shortlist entry is a conjecture; the caveats are the known counterexamples.</p>

<footer>
  config <code>{{ result.config_hash }}</code> · cache <code>{{ result.cache_fingerprint }}</code> · offline {{ result.offline }} · language model: {{ result.llm_usage | dictsort | map("join", "=") | join(", ") }}
</footer>
</main>
</body>
</html>
